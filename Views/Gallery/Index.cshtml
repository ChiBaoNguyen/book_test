@{

    var pageTitle = ViewData["Title"] as string ?? "Thư viện ảnh";

}



<section class="heritage-section">

    <div class="heritage-section-inner">

        <div class="content-section-header" id="gallerySectionHeader"></div>



        @await Html.PartialAsync("_GalleryAlbumImageSection")

        @await Html.PartialAsync("_GalleryAlbumVideoSection")

        @await Html.PartialAsync("_GalleryAlbum3dSection")

    </div>

</section>



@await Html.PartialAsync("_GalleryModals")



@section Scripts {

    <script>

        window.GALLERY_PAGE = {

            mode: 'index',

            initialPageTitle: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pageTitle)),

            heritageAlbumCode: 'heritage-gallery',

            galleryBaseUrl: '@Url.Action("Index", "Gallery")',

            imageAutoplay: true,

            imageAutoplayInterval: 4000

        };

    </script>

    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>

    <script src="~/js/gallery.js" asp-append-version="true"></script>

}

