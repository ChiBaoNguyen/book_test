@model GalleryMediaViewerViewModel
@{
    var gridId = Model?.GridId ?? "galleryDetailVideos";
    var paginationId = Model?.PaginationId ?? "galleryDetailVideosPagination";
    var panelKey = Model?.PanelKey ?? "video";
    var gridClass = Model?.GridClass ?? "gallery-video-grid";
    var paginationLabel = Model?.PaginationAriaLabel ?? "Phân trang video";
    var wrapInPanel = Model?.WrapInPanel ?? true;
    var isActive = Model?.IsActive ?? true;
    var panelClass = "gallery-detail-panel" + (isActive ? " active" : "");
}

@if (wrapInPanel)
{
    <div class="@panelClass" data-panel="@panelKey">
        <div class="@gridClass" id="@gridId">
            <div class="gallery-loading"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
        </div>
        <div class="gallery-album-pagination d-none" id="@paginationId" aria-label="@paginationLabel"></div>
    </div>
}
else
{
    <div class="@gridClass" id="@gridId">
        <div class="gallery-loading"><div class="spinner-border spinner-border-sm text-warning" role="status"></div></div>
    </div>
    <div class="gallery-album-pagination d-none" id="@paginationId" aria-label="@paginationLabel"></div>
}
