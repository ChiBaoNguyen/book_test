@using Microsoft.Extensions.Configuration
@using System.Text.Json
@inject IConfiguration Configuration
@{
    var settings = await ApiService.GetSettingsAsync();
    var siteFavicon = settings?.GetValueOrDefault("SITE_FAVICON", "");
    var siteName = settings?.GetValueOrDefault("SITE_NAME", "Bookle");
    var metaDescription = settings?.GetValueOrDefault("META_DESCRIPTION", "");
    var metaKeywords = settings?.GetValueOrDefault("META_KEYWORDS", "");
    var googleAnalyticsId = settings?.GetValueOrDefault("GOOGLE_ANALYTICS_ID", "") ?? Configuration["GoogleSettings:AnalyticsId"] ?? "";
    var googleMapsApiKey = settings?.GetValueOrDefault("GOOGLE_MAPS_API_KEY", "") ?? Configuration["GoogleSettings:MapsApiKey"] ?? "";
    var pageTitle = ViewData["Title"] != null ? $"{ViewData["Title"]} - {siteName}" : siteName;
    var isHomePage = ViewData["Title"] as string == "Trang chủ"
        || Context.Request.Path.Value == "/"
        || Context.Request.Path.Value?.Equals("/Home/Index", StringComparison.OrdinalIgnoreCase) == true;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrEmpty(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    @if (!string.IsNullOrEmpty(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords" />
    }
    @if (!string.IsNullOrEmpty(siteFavicon))
    {
        <link rel="icon" type="image/x-icon" href="@siteFavicon" />
        <link rel="shortcut icon" type="image/x-icon" href="@siteFavicon" />
    }
    else
    {
        <link rel="shortcut icon" href="~/assets/img/favicon.png">
    }

    <!-- Bookle Template CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/heritage-bundle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />

    <!--<< Bootstrap min.css >>-->
    <link rel="stylesheet" href="~/css/bookle/bootstrap.min.css">
    <!--<< All Min Css >>-->
    <link rel="stylesheet" href="~/css/bookle/all.min.css">
    <!--<< Animate.css >>-->
    <link rel="stylesheet" href="~/css/bookle/animate.css">
    <!--<< Magnific Popup.css >>-->
    <link rel="stylesheet" href="~/css/bookle/magnific-popup.css">
    <!--<< MeanMenu.css >>-->
    <link rel="stylesheet" href="~/css/bookle/meanmenu.css">
    <!--<< Swiper Bundle.css >>-->
    <link rel="stylesheet" href="~/css/bookle/swiper-bundle.min.css">
    <!--<< Nice Select.css >>-->
    <link rel="stylesheet" href="~/css/bookle/nice-select.css">
    <!--<< Icomoon.css >>-->
    <link rel="stylesheet" href="~/css/bookle/icomoon.css">
    <!--<< Main.css >>-->
    <link rel="stylesheet" href="~/css/bookle/main.css">


    @if (!string.IsNullOrEmpty(googleAnalyticsId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@googleAnalyticsId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '@googleAnalyticsId');
        </script>
    }

    @if (!string.IsNullOrEmpty(googleMapsApiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@googleMapsApiKey&loading=async" async defer></script>
    }

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="heritage-body">
    @await Html.PartialAsync("_Menu")

    @* @await Html.PartialAsync("_Slider") *@

@*     @if (isHomePage)
    {
        @await Html.PartialAsync("_BenefitsBar")
    } *@

    <main role="main">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

@*     @await Html.PartialAsync("_FloatContact") *@

    <!-- Bookle Template JS Plugins -->
    <script src="~/assets/js/jquery-3.7.1.min.js"></script>
    <script src="~/assets/js/viewport.jquery.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/jquery.nice-select.min.js"></script>
    <script src="~/assets/js/jquery.waypoints.js"></script>
    <script src="~/assets/js/jquery.counterup.min.js"></script>
    <script src="~/assets/js/swiper-bundle.min.js"></script>
    <script src="~/assets/js/jquery.meanmenu.min.js"></script>
    <script src="~/assets/js/jquery.magnific-popup.min.js"></script>
    <script src="~/assets/js/wow.min.js"></script>
    <script src="~/assets/js/gsap.min.js"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>

    <script>
        window.SITE_SETTINGS = @Html.Raw(JsonSerializer.Serialize(settings ?? new Dictionary<string, string>()));
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/heritage.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
