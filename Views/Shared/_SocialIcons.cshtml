@{
    Dictionary<string, string>? settings = null;
    if (ViewData["Settings"] != null)
    {
        settings = ViewData["Settings"] as Dictionary<string, string>;
    }
    else if (ViewBag.Settings != null)
    {
        settings = ViewBag.Settings as Dictionary<string, string>;
    }
    else
    {
        settings = await ApiService.GetSettingsAsync();
    }
    
    var facebookLink = settings?.GetValueOrDefault("FACEBOOK_URL", "") ?? "";
    var twitterLink = settings?.GetValueOrDefault("TWITTER_URL", "") ?? "";
    var instagramLink = settings?.GetValueOrDefault("INSTAGRAM_URL", "") ?? "";
    var youtubeLink = settings?.GetValueOrDefault("YOUTUBE_URL", "") ?? "";
    var linkedInLink = settings?.GetValueOrDefault("LINKEDIN_URL", "") ?? "";
}

<div class="social-icons">
    @if (!string.IsNullOrEmpty(facebookLink))
    {
        <a href="@facebookLink" target="_blank" rel="noopener noreferrer" class="social-icon" title="Facebook">
            <i class="bi bi-facebook"></i>
        </a>
    }
    @if (!string.IsNullOrEmpty(twitterLink))
    {
        <a href="@twitterLink" target="_blank" rel="noopener noreferrer" class="social-icon" title="Twitter">
            <i class="bi bi-twitter"></i>
        </a>
    }
    @if (!string.IsNullOrEmpty(instagramLink))
    {
        <a href="@instagramLink" target="_blank" rel="noopener noreferrer" class="social-icon" title="Instagram">
            <i class="bi bi-instagram"></i>
        </a>
    }
    @if (!string.IsNullOrEmpty(youtubeLink))
    {
        <a href="@youtubeLink" target="_blank" rel="noopener noreferrer" class="social-icon" title="YouTube">
            <i class="bi bi-youtube"></i>
        </a>
    }
    @if (!string.IsNullOrEmpty(linkedInLink))
    {
        <a href="@linkedInLink" target="_blank" rel="noopener noreferrer" class="social-icon" title="LinkedIn">
            <i class="bi bi-linkedin"></i>
        </a>
    }
</div>

