<div class="contact-info-box" id="contactInfoBox">
    <p class="contact-section-label contact-section-label--light" data-i18n="contactInfoLabel">Thông tin liên hệ</p>
    <h3 class="contact-info-box__title" id="contactInfoOrgName"></h3>
    <div class="contact-info-item" data-contact-field="address">
        <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-geo-alt-fill"></i></div>
        <div>
            <p class="contact-info-item__label" data-i18n="contactLabelAddress">Địa chỉ</p>
            <p class="contact-info-item__value" id="contactInfoAddress"></p>
        </div>
    </div>
    <div class="contact-info-item" data-contact-field="phone">
        <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-telephone-fill"></i></div>
        <div>
            <p class="contact-info-item__label" data-i18n="contactLabelHotline">Hotline</p>
            <p class="contact-info-item__value" id="contactInfoPhone"></p>
        </div>
    </div>
    <div class="contact-info-item" data-contact-field="email">
        <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-envelope-fill"></i></div>
        <div>
            <p class="contact-info-item__label" data-i18n="contactLabelEmail">Email</p>
            <p class="contact-info-item__value" id="contactInfoEmail"></p>
        </div>
    </div>
    <div class="contact-info-item" data-contact-field="fax">
        <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-printer-fill"></i></div>
        <div>
            <p class="contact-info-item__label" data-i18n="contactLabelFax">Fax</p>
            <p class="contact-info-item__value" id="contactInfoFax"></p>
        </div>
    </div>
    <div class="contact-info-item" data-contact-field="website">
        <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-globe"></i></div>
        <div>
            <p class="contact-info-item__label" data-i18n="contactLabelWebsite">Website</p>
            <p class="contact-info-item__value" id="contactInfoWebsite"></p>
        </div>
    </div>
    <div class="contact-info-item" data-contact-field="zalo">
        <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-chat-dots-fill"></i></div>
        <div>
            <p class="contact-info-item__label" data-i18n="contactLabelZalo">Zalo OA</p>
            <p class="contact-info-item__value" id="contactInfoZalo"></p>
        </div>
    </div>
</div>
