<div class="contact-actions-box" id="contactActionsBox">
    <p class="contact-section-label" data-i18n="contactQuickSupport">Hỗ trợ nhanh</p>
    <div class="d-flex flex-column gap-2 mt-3">
        <a href="#" id="contactActionHotline" class="contact-action-btn d-none">
            <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-telephone-fill"></i></div>
            <div>
                <p class="contact-action-btn__label" data-i18n="contactActionCall">Gọi hotline ngay</p>
                <p class="contact-action-btn__sub" id="contactActionHotlineSub"></p>
            </div>
            <span class="contact-action-btn__arrow"><i class="bi bi-chevron-right"></i></span>
        </a>
        <a href="#" id="contactActionZalo" class="contact-action-btn d-none" target="_blank" rel="noopener noreferrer">
            <div class="contact-icon-circle contact-icon-circle--light"><i class="bi bi-chat-dots-fill"></i></div>
            <div>
                <p class="contact-action-btn__label" data-i18n="contactActionZalo">Chat Zalo</p>
                <p class="contact-action-btn__sub" id="contactActionZaloSub"></p>
            </div>
            <span class="contact-action-btn__arrow"><i class="bi bi-chevron-right"></i></span>
        </a>
    </div>
</div>