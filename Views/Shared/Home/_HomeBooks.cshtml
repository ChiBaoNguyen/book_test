<script>
    (() => {
        const API_CATEGORIES_URL = '/api/Portal/categories';
        const API_BOOKS_URL = '/api/Portal/books';
        const PAGE_SIZE = 8;

        const slider = document.querySelector('[data-home-books-tabs-slider]');
        const tabsList = document.querySelector('[data-home-books-categories]');
        const content = document.querySelector('[data-home-books-content]');

        if (!slider || !tabsList || !content) return;

        const wrapper = slider.closest('.home-books-wrapper');
        const viewport = slider.querySelector('.home-books-tabs-viewport');
        const prevButton = slider.querySelector('.home-books-tabs-prev');
        const nextButton = slider.querySelector('.home-books-tabs-next');
        const loadedCategories = new Set();

        if (!viewport || !prevButton || !nextButton) return;

        const getLangCode = () => (localStorage.getItem('selectedLanguage') || 'vi').toLowerCase();

        const escapeHtml = (value) => String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');

        const renderStatus = (message, isLoading = false) => {
            wrapper?.classList.add('home-books-wrapper--api-loading');
            tabsList.innerHTML = isLoading
                ? '<li class="nav-item home-books-api-state" role="presentation"><button class="nav-link active" type="button" disabled>Đang tải...</button></li>'
                : '';
            content.innerHTML = `
                <div class="tab-pane fade show active home-books-api-state" role="tabpanel" tabindex="0">
                    <div class="row">
                        <div class="col-12">
                            <p class="mb-0 text-muted">${escapeHtml(message)}</p>
                        </div>
                    </div>
                </div>`;
            updateButtons();
        };

        const stripHtml = (value) => {
            const temp = document.createElement('div');
            temp.innerHTML = String(value ?? '');
            return temp.textContent || temp.innerText || '';
        };

        const getItems = (payload) => {
            if (Array.isArray(payload)) return payload;
            return payload?.items || payload?.Items || payload?.data || payload?.Data || [];
        };

        const pickTranslation = (item, langCode) => {
            const translations = item?.translations || item?.Translations || [];
            if (!Array.isArray(translations) || !translations.length) return null;

            return translations.find(t => String(t.languageCode || t.LanguageCode || '').toLowerCase() === langCode)
                || translations.find(t => String(t.languageCode || t.LanguageCode || '').toLowerCase().slice(0, 2) === langCode.slice(0, 2))
                || translations[0];
        };

        const categoryId = (category) => category?.id || category?.Id || category?.categoryId || category?.CategoryId
            || category?.value || category?.Value || category?.code || category?.Code || '';

        const categoryName = (category, langCode) => {
            const translation = pickTranslation(category, langCode);
            return translation?.name || translation?.Name || translation?.title || translation?.Title
                || category?.name || category?.Name || category?.title || category?.Title
                || category?.categoryName || category?.CategoryName || category?.code || category?.Code || '';
        };

        const normalizeCategories = (payload, langCode) => getItems(payload)
            .map(category => ({
                id: String(categoryId(category)).trim(),
                name: String(categoryName(category, langCode)).trim()
            }))
            .filter(category => category.id && category.name);

        const paneId = (id, index) => `home-books-category-${index}-${String(id).replace(/[^a-zA-Z0-9_-]/g, '') || 'item'}`;

        const updateButtons = () => {
            const maxScrollLeft = viewport.scrollWidth - viewport.clientWidth;
            const hasOverflow = maxScrollLeft > 1;

            prevButton.hidden = !hasOverflow;
            nextButton.hidden = !hasOverflow;
            prevButton.disabled = viewport.scrollLeft <= 1;
            nextButton.disabled = viewport.scrollLeft >= maxScrollLeft - 1;
        };

        const scrollTabs = (direction) => {
            viewport.scrollBy({
                left: direction * Math.max(260, viewport.clientWidth * .75),
                behavior: 'smooth'
            });
        };

        const bindTabs = () => {
            tabsList.querySelectorAll('.nav-link').forEach((tab) => {
                if (tab.dataset.homeBooksBound === '1') return;

                tab.dataset.homeBooksBound = '1';
                tab.addEventListener('shown.bs.tab', () => {
                    tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

                    const id = tab.dataset.categoryId;
                    const target = tab.getAttribute('data-bs-target');
                    if (id && target) {
                        loadBooksByCategory(id, target);
                    }
                });
            });

            updateButtons();
        };

        const renderCategories = (categories) => {
            loadedCategories.clear();
            wrapper?.classList.remove('home-books-wrapper--api-loading');

            tabsList.innerHTML = categories.map((category, index) => {
                const targetId = paneId(category.id, index);
                const activeClass = index === 0 ? ' active' : '';
                const selected = index === 0 ? 'true' : 'false';

                return `
                    <li class="nav-item" role="presentation">
                        <button class="nav-link${activeClass}" id="${targetId}-tab" data-bs-toggle="pill"
                                data-bs-target="#${targetId}" data-category-id="${escapeHtml(category.id)}"
                                type="button" role="tab" aria-controls="${targetId}" aria-selected="${selected}">
                            ${escapeHtml(category.name)}
                        </button>
                    </li>`;
            }).join('');

            content.innerHTML = categories.map((category, index) => {
                const targetId = paneId(category.id, index);
                const activeClass = index === 0 ? ' show active' : '';

                return `
                    <div class="tab-pane fade${activeClass}" id="${targetId}" role="tabpanel"
                         aria-labelledby="${targetId}-tab" tabindex="0">
                        <div class="row" data-home-books-list="${escapeHtml(category.id)}">
                            <div class="col-12">
                                <p class="mb-0 text-muted">Đang tải sách...</p>
                            </div>
                        </div>
                    </div>`;
            }).join('');

            bindTabs();
            loadBooksByCategory(categories[0].id, `#${paneId(categories[0].id, 0)}`);
        };

        const bookTranslation = (book, langCode) => pickTranslation(book, langCode) || {};

        const bookLink = (translation) => {
            const slug = translation?.urlSlug || translation?.UrlSlug || '';
            return `/book/${encodeURIComponent(slug || 'book')}`;
        };

        const renderBookCard = (book, langCode) => {
            const translation = bookTranslation(book, langCode);
            const title = translation?.title || translation?.Title || book?.title || book?.Title || 'Book';
            const summary = stripHtml(translation?.summary || translation?.Summary || translation?.description || translation?.Description || '');
            const thumbnail = book?.thumbnail || book?.Thumbnail || '/assets/img/book/01.png';
            const author = book?.author || book?.Author || '';
            const link = bookLink(translation);

            return `
                <div class="col-xl-3 col-lg-4 col-md-6 wow fadeInUp">
                    <div class="shop-box-items">
                        <div class="book-thumb center">
                            <a href="${escapeHtml(link)}">
                                <img src="${escapeHtml(thumbnail)}" alt="${escapeHtml(title)}" loading="lazy"
                                     onerror="this.src='/assets/img/book/01.png'">
                            </a>
                            <ul class="shop-icon d-grid justify-content-center align-items-center">
                                <li><a href="${escapeHtml(link)}"><i class="far fa-eye"></i></a></li>
                            </ul>
                        </div>
                        <div class="shop-content">
                            ${author ? `<p class="mb-1 text-muted">${escapeHtml(author)}</p>` : ''}
                            <h3><a href="${escapeHtml(link)}">${escapeHtml(title)}</a></h3>
                            ${summary ? `<p class="mb-3">${escapeHtml(summary.substring(0, 90))}${summary.length > 90 ? '...' : ''}</p>` : ''}
                            <div class="shop-button">
                                <a href="${escapeHtml(link)}" class="theme-btn">
                                    <i class="fa-solid fa-book-open"></i> Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>`;
        };

        async function loadBooksByCategory(categoryId, targetSelector) {
            if (loadedCategories.has(categoryId)) return;

            const pane = content.querySelector(targetSelector);
            const list = pane?.querySelector('[data-home-books-list]');
            if (!list) return;

            loadedCategories.add(categoryId);

            try {
                const url = `${API_BOOKS_URL}?categoryId=${encodeURIComponent(categoryId)}&pageNumber=1&pageSize=${PAGE_SIZE}`;
                const response = await fetch(url, { headers: { Accept: 'application/json' } });

                if (!response.ok) throw new Error('Cannot load books');

                const langCode = getLangCode();
                const books = getItems(await response.json())
                    .filter(book => (book?.published ?? book?.Published ?? true))
                    .slice(0, PAGE_SIZE);

                list.innerHTML = books.length
                    ? books.map(book => renderBookCard(book, langCode)).join('')
                    : '<div class="col-12"><p class="mb-0 text-muted">Chưa có sách trong danh mục này.</p></div>';
            } catch (error) {
                loadedCategories.delete(categoryId);
                list.innerHTML = '<div class="col-12"><p class="mb-0 text-muted">Không tải được sách cho danh mục này.</p></div>';
            }
        }

        async function loadHomeBookCategories() {
            renderStatus('Đang tải danh mục...', true);

            try {
                const langCode = getLangCode();
                const response = await fetch(`${API_CATEGORIES_URL}?langCode=${encodeURIComponent(langCode)}`, {
                    headers: { Accept: 'application/json' }
                });

                if (!response.ok) throw new Error('Cannot load categories');

                const categories = normalizeCategories(await response.json(), langCode);
                if (!categories.length) {
                    renderStatus('Chưa có danh mục sách.');
                    return;
                }

                renderCategories(categories);
            } catch (error) {
                renderStatus('Không tải được danh mục từ API.');
            }
        }

        prevButton.addEventListener('click', () => scrollTabs(-1));
        nextButton.addEventListener('click', () => scrollTabs(1));
        viewport.addEventListener('scroll', updateButtons, { passive: true });
        window.addEventListener('resize', updateButtons);
        window.addEventListener('languageChanged', loadHomeBookCategories);

        loadHomeBookCategories();
    })();
</script>
