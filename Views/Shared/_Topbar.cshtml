@{
    var settings = await ApiService.GetSettingsAsync();
    var hotline = settings?.GetValueOrDefault("SITE_PHONE", "");
    var email = settings?.GetValueOrDefault("SITE_EMAIL", "");
    var languages = await ApiService.GetLanguagesAsync();
    var defaultLanguage = languages?.FirstOrDefault(l => l.IsDefault) ?? languages?.FirstOrDefault();
    var currentLangCode = defaultLanguage?.Code?.ToUpper() ?? "VI";
}

<div class="topbar">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="topbar-left">
                    @if (!string.IsNullOrEmpty(hotline))
                    {
                        <span class="topbar-text">Hotline: <a href="tel:@hotline.Replace(" ", "")">@hotline</a></span>
                    }
                    @if (!string.IsNullOrEmpty(email))
                    {
                        <span class="topbar-text">Email: <a href="mailto:@email">@email</a></span>
                    }
                </div>
            </div>
            <div class="col-md-6 text-end">
                <div class="topbar-right">
                    <!-- Social Icons -->
                    @{
                        ViewData["Settings"] = settings;
                    }
                    @await Html.PartialAsync("_SocialIcons")
                    
                    <span class="topbar-separator">|</span>
                    
                    <!-- Language Selector -->
                    @if (languages != null && languages.Any())
                    {
                        <div class="language-selector">
                            <div class="dropdown">
                                <button class="btn btn-link dropdown-toggle language-btn" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-globe"></i> <span class="current-lang">@currentLangCode</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                                    @foreach (var lang in languages)
                                    {
                                        <li>
                                            <a class="dropdown-item language-option @(lang.IsDefault ? "active" : "")" href="#" data-lang="@lang.Code" data-lang-name="@lang.Name">
                                                @if (!string.IsNullOrEmpty(lang.FlagIcon))
                                                {
                                                    <img src="@lang.FlagIcon" alt="@lang.Name" class="flag-icon" />
                                                }
                                                else
                                                {
                                                    <i class="bi bi-flag"></i>
                                                }
                                                @lang.Name
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<script>
    // Language selector functionality
    document.addEventListener('DOMContentLoaded', function() {
        const languageOptions = document.querySelectorAll('.language-option');
        const currentLangSpan = document.querySelector('.current-lang');
        
        // Get current language from localStorage or default to 'vi'
        let currentLang = localStorage.getItem('selectedLanguage') || 'vi';
        if (!currentLang && currentLangSpan) {
            currentLang = currentLangSpan.textContent.trim().toLowerCase() || 'vi';
        }
        // Ensure default is 'vi' if still empty
        if (!currentLang) {
            currentLang = 'vi';
            localStorage.setItem('selectedLanguage', 'vi');
        }
        
        // Update display based on stored language
        if (currentLang) {
            updateLanguageDisplay(currentLang);
            // Mark active language
            languageOptions.forEach(option => {
                if (option.getAttribute('data-lang')?.toLowerCase() === currentLang.toLowerCase()) {
                    option.classList.add('active');
                } else {
                    option.classList.remove('active');
                }
            });
        }
        
        languageOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const lang = this.getAttribute('data-lang');
                const langName = this.getAttribute('data-lang-name');
                
                if (lang) {
                    currentLang = lang;
                    localStorage.setItem('selectedLanguage', lang);
                    updateLanguageDisplay(lang);
                    
                    // Update active state
                    languageOptions.forEach(opt => {
                        if (opt === this) {
                            opt.classList.add('active');
                        } else {
                            opt.classList.remove('active');
                        }
                    });
                    
                    // Dispatch event to notify other components (e.g., menu)
                    window.dispatchEvent(new CustomEvent('languageChanged', {
                        detail: { langCode: lang, langName: langName }
                    }));
                    
                    // Reload menu with new language
                    if (window.loadMenu) {
                        window.loadMenu(lang);
                    }
                    
                }
            });
        });
        
        function updateLanguageDisplay(lang) {
            if (currentLangSpan && lang) {
                currentLangSpan.textContent = lang.toUpperCase();
            }
        }
    });
</script>

