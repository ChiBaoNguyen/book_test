@{
    var settings = await ApiService.GetSettingsAsync();
    var siteName = settings?.GetValueOrDefault("SITE_NAME", "Bookle");
    var siteLogo = settings?.GetValueOrDefault("SITE_LOGO", "");
    var hotline = settings?.GetValueOrDefault("SITE_PHONE", "");
    var email = settings?.GetValueOrDefault("SITE_EMAIL", "");
    var languages = await ApiService.GetLanguagesAsync();
}

<!-- Offcanvas Area start  -->
<div class="fix-area">
    <div class="offcanvas__info">
        <div class="offcanvas__wrapper">
            <div class="offcanvas__content">
                <div class="offcanvas__top mb-5 d-flex justify-content-between align-items-center">
                    <div class="offcanvas__logo">
                        <a href="@Url.Action("Index", "Home")">
                            @if (!string.IsNullOrEmpty(siteLogo))
                            {
                                <img src="@siteLogo" alt="@siteName" />
                            }
                            else
                            {
                                <img src="/assets/img/logo/black-logo.svg" alt="@siteName">
                            }
                        </a>
                    </div>
                    <div class="offcanvas__close">
                        <button>
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
        @*         <p class="text d-none d-xl-block">
                    Nullam dignissim, ante scelerisque the is euismod fermentum odio sem semper the is erat, a
                    feugiat leo urna eget eros. Duis Aenean a imperdiet risus.
                </p> *@
                <div class="mobile-menu fix mb-3" id="heritageMobileNav"></div>
                <div class="offcanvas__contact">
                    <h4>Thông tin liên hệ</h4>
                    <ul>
                        @if (!string.IsNullOrEmpty(hotline))
                        {
                            <li class="d-flex align-items-center">
                                <div class="offcanvas__contact-icon mr-15">
                                    <i class="far fa-phone"></i>
                                </div>
                                <div class="offcanvas__contact-text">
                                    <a href="tel:@hotline">@hotline</a>
                                </div>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(email))
                        {
                            <li class="d-flex align-items-center">
                                <div class="offcanvas__contact-icon mr-15">
                                    <i class="far fa-envelope"></i>
                                </div>
                                <div class="offcanvas__contact-text">
                                    <a href="mailto:@email">@email</a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="offcanvas__overlay"></div>

<div class="header-top-1">
    <div class="container">
        <div class="header-top-wrapper">
            <ul class="contact-list">
                @if (!string.IsNullOrEmpty(hotline))
                {
                    <li>
                        <i class="fa-regular fa-phone"></i>
                        <a href="tel:@hotline">@hotline</a>
                    </li>
                }
                @if (!string.IsNullOrEmpty(email))
                {
                    <li>
                        <i class="far fa-envelope"></i>
                        <a href="mailto:@email">@email</a>
                    </li>
                }
            </ul>
            <ul class="list">
                @if (languages != null && languages.Any())
                {
                    <li class="heritage-lang" id="heritageLangSwitcher">
                        @foreach (var lang in languages)
                        {
                            <button type="button"
                                    class="lang-option @(lang.IsDefault ? "lang-active active" : "")"
                                    data-heritage-lang="@lang.Code"
                                    title="@lang.Name">
                                @lang.Code.ToUpper()
                            </button>
                            @if (!lang.Equals(languages.Last()))
                            {
                                <span class="lang-sep">/</span>
                            }
                        }
                    </li>
                }
                else
                {
                    <li class="heritage-lang">
                        <span class="lang-active">VI</span>
                        <span class="lang-sep">/</span>
                        <button type="button" class="lang-option" data-heritage-lang="en">EN</button>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- Sticky Header Section start  -->
